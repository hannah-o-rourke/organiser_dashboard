+export async function getPowerLevels(roomId: string) {
+  const res = await fetch(
+    `${homeserver}/_matrix/client/v3/rooms/${encodeURIComponent(roomId)}/state/m.room.power_levels`,
+    { headers: { Authorization: `Bearer ${access_token}` } }
+  );
+  if (!res.ok) throw new Error(`Matrix error ${res.status}`);
+
+  return await res.json() as { users?: { [userId: string]: number }; users_default?: number };
+}
