# Public URL the tool hub uses to reach this tool (your ngrok / cloudflare tunnel URL)
tool_url=
# Base URL of the tool hub, used for dashboard links and for importing earlier history
hub_url=
# Shared secret in the registration JSON, lets the tool post to the group via the hub's /api/send
engagement_secret=
# Matrix user id of the tool hub, so imported history leaves out its messages (learnt from live events otherwise)
bot_user_id=
# Anthropic API key for "find this month's themes" (optional; the button is hidden without it)
ANTHROPIC_API_KEY=
# Matrix power level that counts as a WhatsApp/Signal group admin (default 50)
ADMIN_POWER_LEVEL=
# Hours between an admin switching AI summaries on (which posts the opt-out notice) and the first summary (default 48)
AI_NOTICE_HOURS=
# Resend, for emailing organisers their dashboard link. Emails come from engagement@dashboard.chathackers.uk, so dashboard.chathackers.uk must be verified in this Resend account
RESEND_API_KEY=
